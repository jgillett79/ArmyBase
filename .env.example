# Copy this file to ".env" (same folder) and fill in your free Cloudflare values.
# The .env file is git-ignored so your token stays private.
#
# Where to get these (Free plan is enough — 10,000 Neurons/day at no charge):
#   1. Sign up / log in: https://dash.cloudflare.com
#   2. AI -> Workers AI -> "Use REST API"
#   3. Create an API token with Workers AI Read + Edit permissions -> copy it
#   4. Copy your Account ID shown on the same page

CF_ACCOUNT_ID=your_account_id_here
CF_API_TOKEN=your_api_token_here
